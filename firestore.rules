// Firestore Rules project harmoni-indonesia — dipakai bersama oleh semua app Harmoni.
// Di-deploy otomatis oleh GitHub Actions saat file ini berubah di main; jangan edit
// langsung di Firebase Console karena akan tertimpa deploy berikutnya.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function profilSaya() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isOwner() {
      return request.auth != null && profilSaya().get('role', '') == 'owner';
    }
    function isAktif() {
      return request.auth != null && profilSaya().get('aktif', false) == true;
    }
    function punyaApp(key) {
      return isAktif() && (profilSaya().get('role', '') == 'owner'
        || profilSaya().get('apps', {}).get(key, {}).get('akses', false) == true);
    }

    // Profil user
    match /users/{uid} {
      // User hanya bisa membaca profilnya sendiri
      allow read: if request.auth != null && request.auth.uid == uid;

      // Daftar mandiri: hanya boleh sebagai staff yang belum aktif, tanpa akses app
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('role', '') == 'staff'
        && request.resource.data.get('aktif', true) == false
        && !('apps' in request.resource.data);

      // User boleh mengubah profilnya sendiri, kecuali kolom yang mengatur hak akses
      allow update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['role', 'aktif', 'apps', 'toko', 'username', 'email']);

      // Owner bisa semua
      allow read, write: if isOwner();
    }

    // Data Sistem Penjahit — hanya user yang sudah disetujui (aktif)
    match /toko/{document=**} {
      allow read, write: if isAktif();
    }
    match /shared/{document=**} {
      allow read, write: if isAktif();
    }
    match /settings/{docId} {
      allow read, write: if isAktif();
    }

    // Data Harmoni Analitik — hanya user dengan akses Analitik
    match /penjualan/{docId} {
      allow read, write: if punyaApp('harmoni_analitik');
    }

    // ── Data Laporan Keuangan — koleksi berawalan lk_ ──
    function lkUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function lkRole() {
      let u = lkUser();
      return u.get('role', '') == 'owner'
        ? 'developer'
        : u.get('apps', {}).get('laporan_keuangan', {}).get('role', 'kasir');
    }
    function lkBolehAkses() {
      let u = lkUser();
      return request.auth != null
        && u.get('aktif', false) == true
        && (u.get('role', '') == 'owner'
            || u.get('apps', {}).get('laporan_keuangan', {}).get('akses', false) == true);
    }
    function lkBolehTulis(koleksi) {
      let r = lkRole();
      return r == 'developer'
        || (r == 'pengurus' && koleksi != 'lk_users')
        || (r == 'kasir' && koleksi in ['lk_kasir', 'lk_pembelian', 'lk_piutang', 'lk_pengajuan_kas', 'lk_kategori']);
    }
    function lkTransaksi(k) {
      return k in ['lk_kasir', 'lk_pembelian', 'lk_mutasi', 'lk_piutang', 'lk_piutang_bayar',
                   'lk_po', 'lk_anggaran', 'lk_pengajuan_kas'];
    }
    function lkMilikRole() {
      return resource.data.get('inputByRole', resource.data.get('pengajuRole', '')) == lkRole();
    }
    function lkUbah() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function lkKeyApproval() {
      return ['statusApproval', 'approvedBy', 'approvedNama', 'approvedAt', 'buktiTransfer'];
    }
    function lkKeyKonfirmasi() {
      return ['status', 'konfirmasiId', 'konfirmasiNama', 'kasirDocId', 'doneAt', 'rejectReason',
              'ditolakTahap', 'ditolakId', 'ditolakNama'];
    }
    function lkBolehAlurKerja(k) {
      let r = lkRole();
      return (k == 'lk_pembelian' && r == 'pengurus' && lkUbah().hasOnly(lkKeyApproval()))
        || (k == 'lk_pengajuan_kas' && r == 'kasir' && lkUbah().hasOnly(lkKeyKonfirmasi()))
        || (k in ['lk_piutang', 'lk_po', 'lk_anggaran'] && r == 'pengurus' && lkUbah().hasOnly(['status']));
    }
    function lkBolehUbahMilik(k) {
      let r = lkRole();
      return lkMilikRole()
        && !(k == 'lk_pembelian' && r == 'kasir' && lkUbah().hasAny(lkKeyApproval()))
        && !(k == 'lk_pengajuan_kas' && r == 'pengurus' && lkUbah().hasAny(lkKeyKonfirmasi()));
    }
    function lkBolehBuat(k) {
      let d = request.resource.data;
      return lkRole() == 'developer'
        || ((!lkTransaksi(k) || d.get('inputByRole', '') == lkRole())
            && !(k == 'lk_pembelian' && d.get('statusApproval', 'menunggu') != 'menunggu')
            && !(k == 'lk_kategori' && d.get('status', '') != 'pending'));
    }
    // Pengurus hanya melihat halaman Kasir. Entri kas yang boleh dibuatnya hanya entri
    // otomatis dari bayar pembelian (autoFromBeli) atau piutang (sumberPiutangId).
    function lkPengurusDiKasir(k) {
      return k == 'lk_kasir' && lkRole() == 'pengurus';
    }
    function lkKasOtomatisSah() {
      let d = request.resource.data;
      return (d.get('autoFromBeli', null) is string
              && existsAfter(/databases/$(database)/documents/lk_pembelian/$(d.autoFromBeli)))
          || (d.get('sumberPiutangId', null) is string
              && existsAfter(/databases/$(database)/documents/lk_piutang/$(d.sumberPiutangId)))
          || lkKasDariApprovalSah();
    }

    // ── Pengajuan pengeluaran: pengaju → cek Owner → approval (approver) → masuk kas ──
    // Status 'cek' → 'approval' → 'done' | 'rejected'; 'pending' = alur lama (konfirmasi Kasir).
    function lkIsApprover() {
      return lkUser().get('apps', {}).get('laporan_keuangan', {}).get('approver', false) == true;
    }
    function lkPgjSetelah(id) {
      return getAfter(/databases/$(database)/documents/lk_pengajuan_kas/$(id)).data;
    }
    // Entri kas dari pengajuan hanya sah bila pengajuan itu disetujui oleh pencatatnya sendiri
    function lkKasDariApprovalSah() {
      let d = request.resource.data;
      return d.get('sumberPengajuanId', null) is string
        && lkPgjSetelah(d.sumberPengajuanId).get('status', '') == 'done'
        && lkPgjSetelah(d.sumberPengajuanId).get('approvalId', '') == request.auth.uid;
    }
    function lkPgjBuatSah() {
      let d = request.resource.data;
      return lkRole() == 'developer'
        || (lkRole() == 'pengurus' && d.get('status', '') == 'cek'
            && d.get('pengajuId', '') == request.auth.uid
            && !d.keys().hasAny(['cekId', 'approvalId', 'kasirDocId', 'konfirmasiId']));
    }
    function lkPgjUbahSah() {
      let sebelum = resource.data.get('status', '');
      let sesudah = request.resource.data.get('status', '');
      let ubah = lkUbah();
      let approverSah = sebelum == 'approval' && lkIsApprover()
        && resource.data.get('pengajuId', '') != request.auth.uid;
      return (approverSah && sesudah == 'done'
              && request.resource.data.get('approvalId', '') == request.auth.uid
              && ubah.hasOnly(['status', 'approvalId', 'approvalNama', 'approvalAt', 'kasirDocId', 'doneAt']))
        || (approverSah && sesudah == 'rejected'
              && ubah.hasOnly(['status', 'rejectReason', 'ditolakTahap', 'ditolakId', 'ditolakNama', 'doneAt']))
        || (sebelum == 'pending' && lkRole() == 'kasir' && sesudah in ['done', 'rejected']
              && ubah.hasOnly(lkKeyKonfirmasi()));
    }
    // ── Transfer internal: hanya Owner mencatat langsung; pengurus mengajukan dulu ──
    function lkTfBuatSah() {
      let d = request.resource.data;
      return lkRole() == 'developer'
        || (lkRole() == 'pengurus' && d.get('status', '') == 'menunggu'
            && d.get('pengajuId', '') == request.auth.uid
            && !d.keys().hasAny(['approvalId', 'mutasiDocId', 'ditolakId']));
    }
    function lkTfHapusSah() {
      return lkRole() == 'developer'
        || (resource.data.get('pengajuId', '') == request.auth.uid
            && resource.data.get('status', '') == 'menunggu');
    }
    function lkPgjHapusSah() {
      return lkRole() == 'developer'
        || (resource.data.get('pengajuId', '') == request.auth.uid
            && resource.data.get('status', '') in ['cek', 'approval']);
    }

    match /{koleksi}/{docId} {
      allow read: if koleksi.matches('lk_.*') && lkBolehAkses();
      allow create: if koleksi.matches('lk_.*') && lkBolehAkses()
        && ((koleksi == 'lk_pengajuan_transfer' && lkTfBuatSah())
            || (koleksi != 'lk_pengajuan_transfer'
                && lkBolehTulis(koleksi) && lkBolehBuat(koleksi)
                && !(lkPengurusDiKasir(koleksi) && !lkKasOtomatisSah())
                && (koleksi != 'lk_pengajuan_kas' || lkPgjBuatSah())
                && (koleksi != 'lk_mutasi' || lkRole() == 'developer')));
      // Pengajuan pengeluaran & transfer punya aturan transisi sendiri
      allow update: if koleksi.matches('lk_.*') && lkBolehAkses()
        && ((koleksi == 'lk_pengajuan_kas' && (lkRole() == 'developer' || lkPgjUbahSah()))
            || (koleksi == 'lk_pengajuan_transfer' && lkRole() == 'developer')
            || (!(koleksi in ['lk_pengajuan_kas', 'lk_pengajuan_transfer'])
                && lkBolehTulis(koleksi)
                && !lkPengurusDiKasir(koleksi)
                && (koleksi != 'lk_mutasi' || lkRole() == 'developer')
                && (lkRole() == 'developer'
                    || (koleksi != 'lk_kategori'
                        && (!lkTransaksi(koleksi) || lkBolehUbahMilik(koleksi) || lkBolehAlurKerja(koleksi))))));
      // Pengurus hanya boleh menghapus entri kas yang ikut terhapus bersama piutangnya
      allow delete: if koleksi.matches('lk_.*') && lkBolehAkses()
        && ((koleksi == 'lk_pengajuan_kas' && lkPgjHapusSah())
            || (koleksi == 'lk_pengajuan_transfer' && lkTfHapusSah())
            || (!(koleksi in ['lk_pengajuan_kas', 'lk_pengajuan_transfer'])
                && !(lkPengurusDiKasir(koleksi) && resource.data.get('sumberPiutangId', null) == null)
                && (koleksi != 'lk_mutasi' || lkRole() == 'developer')
                && (lkRole() == 'developer'
                    || (lkRole() == 'pengurus' && koleksi != 'lk_kategori'
                        && (!lkTransaksi(koleksi) || lkMilikRole())))));
    }
  }
}
